{
  "name": "@multipliers-dev/renovate-workflow",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multipliers-dev/renovate-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/multipliers-dev/renovate-workflow/issues"
  },
  "homepage": "https://github.com/multipliers-dev/renovate-workflow#readme",
  "type": "module",
  "bin": {
    "renovate-workflow": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "files": [
    "dist",
    "README.md",
    "scripts/renovate-freshness-poll.ts",
    "scripts/lib",
    "!scripts/**/*.test.ts",
    "!scripts/fixtures",
    "!scripts/cli.ts",
    "!scripts/check-agent-plugins-spec-drift.ts",
    "!scripts/tsconfig.json",
    "!scripts/tsconfig.build.json",
    "!scripts/*.sh"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p scripts/tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "prepack": "npm run build && npm test",
    "prepare": "sh scripts/prepare-git-hooks.sh",
    "verify:git-hooks": "sh scripts/verify-git-hooks.sh",
    "renovate:freshness-poll": "tsx scripts/renovate-freshness-poll.ts",
    "check:agent-plugins-spec-drift": "tsx scripts/check-agent-plugins-spec-drift.ts",
    "bootstrap:tarball": "tsx scripts/bootstrap-tarball.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
